<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mitc</AssemblyName>
    <RootNamespace>Mitc</RootNamespace>
    <Version>1.0</Version>
    <InformationalVersion>v1.0</InformationalVersion>
    <Authors>Tomoya Ogawa</Authors>
    <Company>Tomoya Ogawa</Company>
    <Copyright>Copyright (c) 2026 Tomoya Ogawa</Copyright>
    <Description>Generate an MIT License from the command line.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
